{
  "name": "trolley-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "tsc -b && tsc -p packages/spec/tsconfig.test.json && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit false",
    "trolley": "node apps/cli/dist/index.js",
    "test:unit": "vitest run",
    "dev": "pnpm --filter @trolleybench/web dev",
    "build:web": "pnpm --filter @trolleybench/web build",
    "verify:suites": "node apps/cli/dist/index.js verify content/suites/canon-v0.yaml",
    "verify:crlf": "node scripts/to-crlf.mjs content && node apps/cli/dist/index.js verify content/suites/canon-v0.yaml && git checkout -- content",
    "verify:inspect": "node apps/cli/dist/index.js export --inspect --suite content/suites/canon-v0.yaml --out exports/canon-v0 && python -m pytest exports/canon-v0/test_conformance.py -q"
  },
  "devDependencies": {
    "@trolleybench/adapters": "workspace:*",
    "@trolleybench/engine": "workspace:*",
    "@trolleybench/inspect-export": "workspace:*",
    "@trolleybench/runner": "workspace:*",
    "@trolleybench/scenarios": "workspace:*",
    "@trolleybench/scoring": "workspace:*",
    "@trolleybench/spec": "workspace:*",
    "@trolleybench/store": "workspace:*",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@neon/config": "^1.7.2",
    "@neon/env": "^1.4.3"
  }
}
